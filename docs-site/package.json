{
  "name": "dativo-talon-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:talon-docs": "node ./scripts/sync-talon-docs.mjs",
    "validate:docs-contract": "node ./scripts/validate-docs-contract.mjs",
    "start": "docusaurus start --host 0.0.0.0",
    "build": "npm run sync:talon-docs && node ./scripts/fix-synced-doc-links.cjs && npm run validate:docs-contract && docusaurus build",
    "serve": "docusaurus serve build"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {},
  "resolutions": {},
  "overrides": {
    "serialize-javascript": "7.0.7",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
